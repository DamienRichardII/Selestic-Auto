{
  "name": "selestic-sim3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Configurateur 3D d'habitacle Selestic Auto (module indépendant, intégré au site statique)",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit",
    "build:model": "tsx scripts/build-model.ts",
    "build": "tsc --noEmit && vite build",
    "build:site": "vite build --outDir ../sim3d --emptyOutDir && node scripts/post-build.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
